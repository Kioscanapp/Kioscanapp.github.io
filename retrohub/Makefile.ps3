ifeq ($(strip $(PSL1GHT)),)
$(error "Set PSL1GHT first, e.g. export PSL1GHT=/usr/local/ps3dev")
endif

include $(PSL1GHT)/ppu_rules

TARGET      := retrovicios_ps3
TITLE       := Retrovicios
APPID       := RVIC00001
CONTENTID   := UP0001-RVIC00001_00-0000000000000001
PKGFILES    := pkgfiles
ICON0       := assets/ICON0.PNG

SOURCES     := source
INCLUDES    := include
SDL2_CONFIG := $(PSL1GHT)/portlibs/ppu/bin/sdl2-config
LIBDIRS     := -L$(PSL1GHT)/portlibs/ppu/lib
LIBS        := $(shell $(SDL2_CONFIG) --libs) -lnet -lsysmodule -lnetctl -lsysfs -llv2 -lm
CFLAGS      += -O2 -Wall -Wextra -std=gnu99 -D__PSL1GHT__ -D__PS3__ -mcpu=cell $(LIBPSL1GHT_INC) -I$(INCLUDES) -I$(PSL1GHT)/portlibs/ppu/include/SDL2 -D_REENTRANT
LDFLAGS     += -mcpu=cell $(LIBDIRS)

CFILES      := $(SOURCES)/main_ps3.c \
               $(SOURCES)/catalog.c \
               $(SOURCES)/systems.c \
               $(SOURCES)/launcher_ps3.c \
               $(SOURCES)/state.c \
               $(SOURCES)/filter.c \
               $(SOURCES)/font5x7.c
OFILES      := $(CFILES:.c=.o)

all: $(TARGET).pkg

$(TARGET).elf: $(OFILES)
	$(CC) $(LDFLAGS) -o $@ $^ $(LIBS)

prepare-package: $(TARGET).self
	mkdir -p $(PKGFILES)/USRDIR
	cp $(TARGET).self $(PKGFILES)/USRDIR/retrovicios.self

$(TARGET).pkg: prepare-package

clean:
	rm -f $(OFILES) $(TARGET).elf $(TARGET).self $(TARGET).fake.self $(TARGET).pkg $(TARGET).gnpdrm.pkg
	rm -rf build
